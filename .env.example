# ==============================================================================
# 🌌 ILLUMINATI UNIFIED AI PLATFORM — ENVIRONMENT CONFIGURATION
# Geek Room AI Global Hackathon • Team Illuminati • Author: Aryan Vishwakarma (@Aryanxp1)
# ==============================================================================

# Mode: Set to false to enable live external LLM & Tavily API calls.
# Set to true for offline deterministic simulation mode (zero-cost, no keys needed).
MOCK_MODE=false

# 1. Model Plane: OpenRouter API Key (OpenAI / Anthropic / DeepSeek inference)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. Knowledge Plane: Tavily Search API Key (Live web search & fact verification)
TAVILY_API_KEY=your_tavily_api_key_here

# 3. Bifrost Gateway Settings (Maxim AI)
BIFROST_URL=http://localhost:8080/v1
BIFROST_API_KEY=bf-illuminati-key
BIFROST_PRIMARY_MODEL=openai/gpt-4o-mini
BIFROST_FALLBACK_MODELS=claude-3-5-haiku,groq/gpt-oss-120b,ollama/llama3

# 4. Token & Cost Governance Defaults (Bifrost PS 01)
DEFAULT_TOKEN_BUDGET=8000
DEFAULT_MAX_COST_USD=0.05
